{
 "buildCommand": "echo build",
 "outputDirectory": "public",
 "functions": {
  "api/data.js": {
   "includeFiles": "api/_full/**",
   "memory": 1024
  },
  "api/mcp.js": {
   "maxDuration": 30
  }
 },
 "rewrites": [
  {
   "source": "/mcp",
   "destination": "/api/mcp"
  },
  {
   "source": "/mcp/",
   "destination": "/api/mcp"
  },
  {
   "source": "/.well-known/openai-apps-challenge",
   "destination": "/api/openai-challenge"
  },
  {
   "source": "/for/:token",
   "destination": "/index.html"
  },
  {
   "source": "/for/:token/",
   "destination": "/index.html"
  }
 ],
 "headers": [
  {
   "source": "/data/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/(.*)\\.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/api/_full/:path*",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/api/%5Ffull/:path*",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/api/%5ffull/:path*",
   "destination": "/",
   "permanent": false
  }
 ]
}
